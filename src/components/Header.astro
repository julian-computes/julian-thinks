---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		margin-bottom: 2rem;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
		padding: 0.5rem 0;
	}

	h2 {
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.2;
	}

	h2 a {
		text-decoration: none;
		color: inherit;
	}

	h2 a:hover,
	h2 a:focus-visible {
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.internal-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-left: 0.5rem;
	}

	.social-links {
		margin-left: auto;
	}

	.social-links :global(a) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: inherit;
		opacity: 0.75;
		transition: opacity 120ms ease;
	}

	.social-links :global(a:hover),
	.social-links :global(a:focus-visible) {
		opacity: 1;
	}

	.social-links :global(svg) {
		width: 1.2rem;
		height: 1.2rem;
	}

	@media (max-width: 50rem) {
		.social-links {
			margin-left: 0;
		}
	}
</style>

