---
import { Image } from "astro:assets";
import type { BlogPost } from "../lib/blog";
import { nextPageHref, prevPageHref, pubDateFromId } from "../lib/blog";
import BaseHead from "./BaseHead.astro";
import Footer from "./Footer.astro";
import FormattedDate from "./FormattedDate.astro";
import Header from "./Header.astro";

interface Props {
	posts: BlogPost[];
	page: number;
	totalPages: number;
	basePath: string;
	title: string;
	description: string;
}

const { posts, page, totalPages, basePath, title, description } = Astro.props;
const prev = prevPageHref(basePath, page);
const next = nextPageHref(basePath, page, totalPages);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<section aria-label="Blog posts">
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h2 class="title">{post.data.title}</h2>
									<p class="date">
										<FormattedDate date={pubDateFromId(post.id)} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
				{(prev || next) && (
					<nav class="pagination" aria-label="Pagination">
						{prev ? <a href={prev}>&larr; Previous</a> : <span />}
						<span class="page-info">Page {page} of {totalPages}</span>
						{next ? <a href={next}>Next &rarr;</a> : <span />}
					</nav>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	li {
		padding: 1.25rem 0;
		border-bottom: 1px solid rgba(128, 128, 128, 0.2);
	}

	li:first-child {
		padding-top: 0;
	}

	li:last-child {
		border-bottom: none;
	}

	a {
		display: block;
		text-decoration: none;
		color: inherit;
		transition: opacity 150ms ease;
	}

	a:hover,
	a:focus-visible {
		opacity: 0.6;
	}

	.title {
		margin: 0;
		font-size: 1.15rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		line-height: 1.4;
	}

	.date {
		margin: 0.3rem 0 0;
		font-size: 0.85rem;
		opacity: 0.5;
	}

	.pagination {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 1.5rem;
		margin-top: 1.5rem;
		border-top: 1px solid rgba(128, 128, 128, 0.2);
	}

	.page-info {
		font-size: 0.85rem;
		opacity: 0.5;
	}
</style>
