---
import { Image } from "astro:assets";
import type { BlogPost } from "@/lib/blog";
import { nextPageHref, prevPageHref, pubDateFromId } from "@/lib/blog";
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import Header from "@/components/Header.astro";

interface Props {
  posts: BlogPost[];
  page: number;
  totalPages: number;
  basePath: string;
  title: string;
  description: string;
  breadcrumbs?: { label: string; href?: string }[];
}

const { posts, page, totalPages, basePath, title, description, breadcrumbs = [] } =
  Astro.props;
const prev = prevPageHref(basePath, page);
const next = nextPageHref(basePath, page, totalPages);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />
    <main id="main-content">
      {
        breadcrumbs.length > 0 && (
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <ol>
              {breadcrumbs.map((item, index) => (
                <li>
                  {item.href && index !== breadcrumbs.length - 1 ? (
                    <a href={item.href}>{item.label}</a>
                  ) : (
                    <span aria-current={index === breadcrumbs.length - 1 ? "page" : undefined}>
                      {item.label}
                    </span>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <section aria-label="Blog posts">
        <ul class="post-list">
          {
            posts.map((post) => (
              <li>
                <a class="post-link" href={`/blog/${post.id}/`}>
                  {post.data.heroImage && (
                    <Image
                      width={720}
                      height={360}
                      src={post.data.heroImage}
                      alt=""
                    />
                  )}
                  <h2 class="title">{post.data.title}</h2>
                  <p class="date">
                    <FormattedDate date={pubDateFromId(post.id)} />
                  </p>
                </a>
              </li>
            ))
          }
        </ul>
        {
          (prev || next) && (
            <nav class="pagination" aria-label="Pagination">
              {prev ? <a href={prev}>&larr; Previous</a> : <span />}
              <span class="page-info">
                Page {page} of {totalPages}
              </span>
              {next ? <a href={next}>Next &rarr;</a> : <span />}
            </nav>
          )
        }
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li {
    padding: 1.25rem 0;
    border-bottom: 1px solid rgba(128, 128, 128, 0.2);
  }

  .post-list li:first-child {
    padding-top: 0;
  }

  .post-list li:last-child {
    border-bottom: none;
  }

  .post-link {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: opacity 150ms ease;
  }

  .post-link:hover,
  .post-link:focus-visible {
    opacity: 0.6;
  }

  .title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.4;
  }

  .date {
    margin: 0.3rem 0 0;
    font-size: 0.85rem;
    opacity: 0.5;
  }

  .pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    margin-top: 1.5rem;
    border-top: 1px solid rgba(128, 128, 128, 0.2);
  }

  .page-info {
    font-size: 0.85rem;
    opacity: 0.5;
  }

  .breadcrumbs {
    margin: 0 0 1rem;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
  }

  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
  }

  .breadcrumbs li + li::before {
    content: "/";
    margin-right: 0.5rem;
    opacity: 0.45;
  }
</style>
