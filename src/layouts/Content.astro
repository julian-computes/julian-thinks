---
import { Image } from "astro:assets";
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import Header from "@/components/Header.astro";
import { SITE_TITLE } from "@/consts";

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  pubDate?: Date;
  updatedDate?: Date;
  heroImage?: ImageMetadata;
  breadcrumbs?: BreadcrumbItem[];
}

const { title, description, pubDate, updatedDate, heroImage, breadcrumbs = [] } = Astro.props;
const blogPostingSchema = pubDate
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description: description,
      datePublished: pubDate.toISOString(),
      ...(updatedDate && { dateModified: updatedDate.toISOString() }),
      author: {
        "@type": "Person",
        name: "Julian Fernandez",
      },
      publisher: {
        "@type": "Person",
        name: "Julian Fernandez",
      },
      isPartOf: {
        "@type": "Blog",
        name: SITE_TITLE,
        url: Astro.site,
      },
    })
  : null;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    {
      blogPostingSchema && (
        <script type="application/ld+json" set:html={blogPostingSchema} />
      )
    }
  </head>

  <body>
    <Header />
    <main id="main-content">
      <article>
        <div class="hero-image">
          {
            heroImage && (
              <Image width={1020} height={510} src={heroImage} alt="" />
            )
          }
        </div>
        <div class="prose">
          {
            breadcrumbs.length > 0 && (
              <nav class="breadcrumbs" aria-label="Post breadcrumbs">
                <ul class="breadcrumb-trail">
                  {breadcrumbs.map((item, index) => (
                    <li>
                      {item.href && index !== breadcrumbs.length - 1 ? (
                        <a href={item.href}>{item.label}</a>
                      ) : (
                        <span aria-current={index === breadcrumbs.length - 1 ? "page" : undefined}>
                          {item.label}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
          <div class="title">
            <h1>{title}</h1>
            <div class="date">
              {pubDate && <FormattedDate date={pubDate} />}
              {
                updatedDate && (
                  <div class="last-updated-on">
                    Last updated on <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
          </div>
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body><style>
    article {
      max-width: 120ch;
    }

    .prose {
      line-height: 1.7;
    }

    .breadcrumbs {
      margin-bottom: 1rem;
    }

    .breadcrumb-trail {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 0.6rem;
      list-style: none;
      padding: 0;
      margin: 0;
      font-size: 0.92rem;
    }

    .breadcrumb-trail li {
      display: inline-flex;
      align-items: center;
    }

    .breadcrumb-trail li + li::before {
      content: "/";
      margin-right: 0.6rem;
      opacity: 0.45;
    }

    .title h1 {
      margin-bottom: 0.25rem;
    }

    .date {
      margin-bottom: 1.5rem;
      color: #64748b;
    }

    .hero-image {
      margin-bottom: 2rem;
    }

    .hero-image img {
      width: 100%;
      height: auto;
      border-radius: 0.5rem;
    }
  </style>
</html>
