---
import { type CollectionEntry, render } from "astro:content";
import BlogPost from "@/layouts/Content.astro";
import { getSortedPosts, pubDateFromId } from "@/lib/blog";

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return posts.map((post) => {
    const [year, month, day, ...rest] = post.id.split("/");

    return {
      params: { year, month, day, post: rest.join("/") },
      props: {
        entry: post,
        year,
        month,
      },
    };
  });
}

interface Props {
  entry: CollectionEntry<"blog">;
  year: string;
  month: string;
}

const { entry, year, month } = Astro.props;
const { Content } = await render(entry);
const monthLabel = new Date(Number(year), Number(month) - 1, 1).toLocaleString(
  "en-US",
  { month: "long" },
);
---

<BlogPost
  {...entry.data}
  pubDate={pubDateFromId(entry.id)}
  breadcrumbs={[
    { label: "Blog", href: "/blog/" },
    { label: year, href: `/blog/${year}/` },
    { label: monthLabel, href: `/blog/${year}/${month}/` },
    { label: entry.data.title },
  ]}
>
  <Content />
</BlogPost>
